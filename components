"use client";
import { useEffect, useState } from "react";

export default function CookieBanner() {
  const [open, setOpen] = useState(false);

  useEffect(() => {
    const consent = localStorage.getItem("cookie-consent");
    if (!consent) setOpen(true);
  }, []);

  if (!open) return null;

  return (
    <div className="fixed bottom-4 inset-x-4 z-50 rounded-xl border bg-white p-4 shadow-md">
      <p className="text-sm">
        Usamos cookies para mejorar tu experiencia. Puedes cambiar preferencias en{" "}
        <a href="/ajustes-privacidad" className="underline">Ajustes de privacidad</a>.
      </p>
      <div className="mt-3 flex gap-2">
        <button
          className="px-3 py-2 rounded-lg border"
          onClick={() => { localStorage.setItem("cookie-consent", "rejected"); setOpen(false); }}
        >
          Rechazar
        </button>
        <button
          className="px-3 py-2 rounded-lg bg-black text-white"
          onClick={() => { localStorage.setItem("cookie-consent", "accepted"); setOpen(false); }}
        >
          Aceptar
        </button>
      </div>
    </div>
  );
}
